// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Industry {
  id    Int     @default(autoincrement()) @id
  name String
  companies Company[]

  @@map("industries")
}

model Company {
  id    Int     @default(autoincrement()) @id
  symbol String @unique
  name String
  displaySymbol String @map("display_symbol")
  currency String
  figi String
  mic String
  type String
  country String?
  exchange String?
  ipo DateTime?
  marketCapitalization Float? @map("market_capitalization")
  shareOutstanding Float? @map("share_outstanding")
  phone String?
  webUrl String? @map("web_url")
  logo String?
  industry Industry? @relation(fields: [industryId], references: [id])
  industryId Int?

  delisted Boolean @default(false)

  earningsCalendars EarningsCalendar[]
  portfolios Portfolio[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  watchlist Watchlist[]
  news News[]

  @@map("companies")
}

model EarningsCalendar {
  id    Int     @default(autoincrement()) @id
  symbol String
  date DateTime
  epsActual Float? @map("eps_actual")
  epsEstimate Float? @map("eps_estimate")
  hour String? 
  quarter Int?
  revenueActual BigInt? @map("revenue_actual")
  revenueEstimate BigInt? @map("revenue_estimate")
  year Int?
  company Company @relation(fields: [symbol], references: [symbol])

  @@unique([symbol, date])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("earnings_calendar")
}

model User {
  id            String        @id @db.Uuid
  email         String        @unique
  display_name  String?
  phone         String?
  providers     String?
  provider_type String?
  
  // Relations
  portfolios    Portfolio[]
  transactions  Transaction[]

  watchlists Watchlist[]

  @@map("users")
}

model Portfolio {
  id        Int       @id @default(autoincrement())
  userId    String    @db.Uuid @map("user_id")
  symbol String
  quantity Float
  avgPrice Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([userId, symbol]) // One entry per stock per user
  @@map("portfolios")
}

model Watchlist {
  id        Int       @id @default(autoincrement())
  userId    String    @db.Uuid @map("user_id")
  symbol    String    
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([userId, symbol]) // One entry per stock per user
  @@map("watchlists")
}

model Transaction {
  id       Int             @id @default(autoincrement())
  symbol   String
  type     TransactionType  // Using the enum here
  quantity Float
  price    Float
  userId   String          @db.Uuid @map("user_id")
  
  // Relations
  company  Company  @relation(fields: [symbol], references: [symbol])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
}

model News {
  id    Int     @default(autoincrement()) @id
  
  symbol String?
  category String?
  datetime DateTime
  headline String
  finnhubID Int? @map("finnhub_id")
  image String?
  source String?
  summary String?
  url String?

  company Company? @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  
  @@index([symbol, headline])
  @@map("news")
}