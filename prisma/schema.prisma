// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Industry {
  id    Int     @default(autoincrement()) @id
  name String
  companies Company[]

  @@map("industries")
}

model Company {
  id    Int     @default(autoincrement()) @id
  symbol String @unique
  name String
  displaySymbol String
  currency String
  figi String
  mic String
  type String
  country String?
  exchange String?
  ipo DateTime?
  marketCapitalization Float?
  shareOutstanding Float?
  phone String?
  webUrl String?
  logo String?
  industry Industry? @relation(fields: [industryId], references: [id])
  industryId Int?

  delisted Boolean @default(false)

  earningsCalendars EarningsCalendar[]
  portfolios Portfolio[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("companies")
}

model EarningsCalendar {
  id    Int     @default(autoincrement()) @id
  symbol String
  date DateTime
  epsActual Float?
  epsEstimate Float?
  hour String?
  quarter Int?
  revenueActual BigInt?
  revenueEstimate BigInt?
  year Int?
  company Company @relation(fields: [symbol], references: [symbol])

  @@unique([symbol, date])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("earnings_calendar")
}

model User {
  id            String        @id @db.Uuid
  email         String        @unique
  display_name  String?
  phone         String?
  providers     String?
  provider_type String?
  
  // Relations
  portfolios    Portfolio[]
  transactions  Transaction[]

  @@map("users")
}

model Portfolio {
  id        Int       @id @default(autoincrement())
  userId    String    @db.Uuid
  symbol    String    
  quantity  Float     @default(0)
  avgPrice  Float    
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [symbol], references: [symbol])

  @@unique([userId, symbol]) // One entry per stock per user
  @@map("portfolios")
}

model Transaction {
  id       Int             @id @default(autoincrement())
  symbol   String
  type     TransactionType  // Using the enum here
  quantity Float
  price    Float
  userId   String          @db.Uuid
  
  // Relations
  company  Company  @relation(fields: [symbol], references: [symbol])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
}